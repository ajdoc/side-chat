APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where uploaded files (attachments, Side Desk documents) are written. `local` is right for a
# single machine. Anywhere that runs more than one container, or replaces containers on deploy,
# needs `s3` — a local disk is per-container and ephemeral, so files land on whichever instance
# served the request and vanish when it's recycled.
#
# Setting this to `s3` also switches uploads to the direct-to-bucket path: the browser PUTs to a
# signed URL instead of streaming through the API, which is what keeps a large upload alive
# across a deploy or a scale-in.
ATTACHMENT_DISK=local

# Largest single upload. Keep NUXT_PUBLIC_MAX_UPLOAD_MB on the frontend in step with this.
MAX_UPLOAD_MB=2048

# S3-compatible storage. These reach any provider, not just AWS — set AWS_ENDPOINT for the rest.
# Cloudflare R2:  AWS_DEFAULT_REGION=auto
#                 AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                 AWS_USE_PATH_STYLE_ENDPOINT=false
# Backblaze B2 / Storj: use their endpoint and region, with path-style set to true.
#
# The bucket must stay private (files are served through signed URLs this app mints) and needs a
# CORS rule allowing PUT and GET from the frontend's origin, or direct uploads fail in the
# browser with an opaque network error.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Every origin the API will answer a browser from — see config/cors.php, and the "The API has
# to allow the app's origin" section of APPS.md. A packaged app is not served from your web
# domain: the desktop shell runs on a loopback HTTP server and the phone shells on Capacitor's
# synthetic origins, and each of those is the `Origin` header the API sees. An origin that
# isn't listed here fails at the browser's preflight, before Laravel is reached at all, which
# surfaces in the app as "Unable to sign in. Please try again."
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:43117,https://localhost,capacitor://localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# WebRTC signalling (SDP offers) travels over Reverb client events and outgrows the
# 10KB default once a screen-share video track is described. See config/webrtc.php.
REVERB_APP_MAX_MESSAGE_SIZE=64000

# Voice: STUN is enough on a LAN/localhost. TURN relays media and is what makes calls
# work behind symmetric NAT or a corporate firewall — point it at your own coturn.
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Optional second TURN from a *different* provider, for failover — clients get both and ICE
# uses whichever answers. Its own credentials, since providers don't cross-authenticate.
WEBRTC_TURN2_URLS=
WEBRTC_TURN2_USERNAME=
WEBRTC_TURN2_CREDENTIAL=
# Cloudflare Realtime TURN, as an alternative or an addition to the above. It has no fixed
# username/password: create a TURN key in the Cloudflare dashboard and put its id and API
# token here, and the backend mints a short-lived credential per session. Blank = not used.
WEBRTC_CLOUDFLARE_TURN_KEY_ID=
WEBRTC_CLOUDFLARE_TURN_API_TOKEN=
WEBRTC_CLOUDFLARE_TURN_TTL=86400
WEBRTC_MAX_PARTICIPANTS=8
