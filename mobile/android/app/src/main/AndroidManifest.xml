<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Screen sharing. A MediaProjection may only run while a foreground service of this
             exact type is up — Android will kill the capture otherwise — and since Android 14
             the service may only be started after the user has granted the projection, which is
             why ScreenCapturePlugin starts it from the consent result rather than up front. -->
        <service
            android:name="chat.side.app.screencapture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Voice calls. A backgrounded app loses the microphone from Android 12 and may only
             hold it from Android 14 behind a foreground service of this exact type, so a call
             that has to survive the user leaving the app needs this service up for its whole
             duration. Started and stopped by the page, on join and on leave. -->
        <service
            android:name="chat.side.app.voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice channels. Capacitor's WebChromeClient asks the user for RECORD_AUDIO the first
         time getUserMedia runs, but only for permissions declared here. MODIFY_AUDIO_SETTINGS
         lets WebRTC put the call on the earpiece/speaker route rather than the media stream.
         CAMERA is declared because a voice channel can turn into a video one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A call has to survive the screen going off, and the app being left. The typed
         microphone permission is required from Android 14 to start VoiceService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Screen sharing. The typed foreground-service permission is required from Android 14;
         POST_NOTIFICATIONS because the service's notification is the user's guaranteed way to
         see that their screen is being read, and to stop it. There is no separate permission
         for the capture itself — that consent is the system sheet, every time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
